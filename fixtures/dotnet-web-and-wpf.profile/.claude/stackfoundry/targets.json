{
  "schemaVersion": 1,
  "docsRoot": "docs",
  "timezone": "UTC",
  "defaultBranch": "main",
  "targets": [
    {
      "name": "api",
      "summary": "HTTP API computing prices and order totals for the public web site.",
      "paths": ["src/Api/**"],
      "testPaths": ["tests/Api.Tests/**"],
      "packs": ["language-csharp", "app-model-aspnet-core", "tooling-xunit"],
      "exposure": "public",
      "stakes": ["money"],
      "gate": {"build": ["dotnet build src/Api -c Release"], "test": ["dotnet test tests/Api.Tests -c Release"]},
      "tests": [{"name": "unit", "kind": "unit", "command": "dotnet test tests/Api.Tests -c Release",
                 "paths": ["tests/Api.Tests/**"]}],
      "profile": ".claude/stackfoundry/targets/api.md"
    },
    {
      "name": "desktop",
      "summary": "WPF label-printing app used by staff at the till.",
      "paths": ["src/Desktop/**"],
      "packs": ["language-csharp", "app-model-wpf", "capability-mvvm-toolkit"],
      "exposure": "staff",
      "stakes": ["data-integrity"],
      "gate": {"build": ["dotnet build src/Desktop -c Release"]},
      "profile": ".claude/stackfoundry/targets/desktop.md"
    }
  ],
  "ignored": ["docs/**", "**/*.md"]
}
