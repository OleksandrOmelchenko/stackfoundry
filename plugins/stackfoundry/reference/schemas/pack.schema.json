{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OleksandrOmelchenko/stackfoundry/schemas/pack.schema.json",
  "title": "stackfoundry pack (.stackfoundry/packs/<id>/pack.json)",
  "description": "One technology in one layer, researched from current sources (reference/pack-research.md) and grounded in this repo. The rulebook .stackfoundry/rules/<id>.md is generated from it.",
  "type": "object",
  "required": ["schemaVersion", "id", "layer", "researchedAt", "versions", "rules", "sources"],
  "$defs": {
    "cite": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "description": "A key of `sources`."}
    },
    "where": {"type": "array", "items": {"type": "string"}, "description": "Path + symbol in this repo where it applies, or 'not used here yet'."}
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^(language|app-model|capability|tooling)-[a-z0-9-]+$"},
    "layer": {"enum": ["language", "app-model", "capability", "tooling"]},
    "title": {"type": "string"},
    "researchedAt": {"type": "string", "format": "date"},
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "pinnedIn"],
        "properties": {
          "version": {"type": "string"},
          "pinnedIn": {"type": "string"},
          "latest": {"type": "string", "description": "Latest stable at research time."}
        }
      }
    },
    "targets": {"type": "array", "items": {"type": "string"}},
    "rulebookPaths": {"type": "array", "items": {"type": "string"}, "description": "The `paths:` globs of the generated rulebook."},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "why", "sources"],
        "properties": {
          "rule": {"type": "string", "description": "The decision, imperative."},
          "why": {"type": "string", "description": "The consequence of getting it wrong."},
          "where": {"$ref": "#/$defs/where"},
          "repoConvention": {"type": "string", "description": "When the repo deliberately differs from the docs: what it does and the evidence."},
          "since": {"type": "string"},
          "until": {"type": "string"},
          "sources": {"$ref": "#/$defs/cite"}
        }
      }
    },
    "bugCategories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "lookFor", "failure", "sources"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "lookFor": {"type": "string"},
          "failure": {"type": "string", "description": "The concrete wrong outcome."},
          "severityHint": {"enum": ["blocker", "confirm", "suggestion"]},
          "sources": {"$ref": "#/$defs/cite"}
        }
      }
    },
    "testing": {
      "type": "object",
      "properties": {
        "layers": {"type": "string", "description": "Which test layer proves what for this technology."},
        "harness": {"$ref": "#/$defs/where"},
        "commands": {"type": "array", "items": {"type": "string"}},
        "shuffle": {"type": "string"},
        "mutation": {"type": "string"},
        "traps": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "items": {"type": "string"}}
      }
    },
    "wiring": {
      "type": "array",
      "description": "How the layer's plumbing must resolve (registrations, routes, config keys, resources, job graphs): the checklist of code-verifier.",
      "items": {"type": "object", "required": ["check", "sources"], "properties": {"check": {"type": "string"}, "failure": {"type": "string"}, "where": {"$ref": "#/$defs/where"}, "sources": {"$ref": "#/$defs/cite"}}}
    },
    "performance": {"type": "array", "items": {"type": "object", "required": ["note", "sources"], "properties": {"note": {"type": "string"}, "where": {"$ref": "#/$defs/where"}, "sources": {"$ref": "#/$defs/cite"}}}},
    "security": {"type": "array", "items": {"type": "object", "required": ["note", "sources"], "properties": {"note": {"type": "string"}, "where": {"$ref": "#/$defs/where"}, "sources": {"$ref": "#/$defs/cite"}}}},
    "upgrade": {
      "type": "object",
      "properties": {
        "pins": {"type": "array", "items": {"type": "string"}},
        "lockStep": {"type": "array", "items": {"type": "string"}},
        "releaseNotes": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "migrationGuides": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "deprecationsInUse": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {
      "type": "object",
      "description": "key -> source. Every rule, category and note cites keys from here.",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "accessed"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "version": {"type": "string", "description": "The version the page describes."},
          "accessed": {"type": "string", "format": "date"}
        }
      }
    },
    "notReached": {"type": "array", "items": {"type": "string"}, "description": "Sections or sources that could not be read, with the reason."},
    "questions": {"type": "array", "items": {"type": "string"}, "description": "Conflicts the user must settle."}
  }
}
